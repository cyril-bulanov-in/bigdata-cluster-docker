# ============================================================================
#  Copy to .env before starting:  cp .env.example .env
#
#  This stack includes 05-minio, which includes 04-etl, 03-dbms, 02-monitoring
#  and 01-kafka. Each reads its own .env from its own directory — all six must
#  exist. `make up` checks.
# ============================================================================

# ---- Spark -----------------------------------------------------------------
# Version 3.5, not 4.x, and the choice is deliberate.
#
# Spark's ability to read s3a:// rests on a chain: the Spark build bundles a
# specific Hadoop version, hadoop-aws must match it exactly, and the AWS SDK
# must match what that hadoop-aws was compiled against. The 3.5 line is the
# best-trodden combination — most working examples target it, and hadoop-aws
# for Hadoop 3.3.x has years of use behind it. Spark 4 also moved to the v2
# AWS SDK, which adds its own class of incompatibilities.
#
# Tags from hub.docker.com/r/apache/spark/tags. The `-r` variants add the R
# runtime and SparkR, which nothing here uses.
SPARK_VERSION=3.5.9
SPARK_IMAGE=apache/spark:3.5.9-scala2.12-java17-python3-ubuntu

# NOT free choices. Spark 3.5.9 compiles in Hadoop 3.3.4 — check with
#   grep hadoop.version in the Spark pom for the tag you pinned
# so hadoop-aws is 3.3.4, and the SDK is what that was built against.
#
# A mismatch gives NoSuchMethodError or ClassNotFoundException from deep in
# the stack, naming neither S3 nor versions. The jars are baked into the image
# at build time so a wrong pair fails the build instead of a running job.
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_VERSION=1.12.262

# ---- Cluster shape ---------------------------------------------------------
# Four workers, one core each. One core apiece on purpose: the point is to see
# how a job spreads across executors, and four single-core workers make the
# split legible in a way two four-core workers do not.
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=1g

# ---- Ports -----------------------------------------------------------------
# 8080 on the host is Kafbat UI and 8081 is Airflow, so the Spark master UI
# goes to 8090.
SPARK_MASTER_UI_PORT=8090
SPARK_MASTER_PORT=7077

# ---- Object storage --------------------------------------------------------
# Where S3A points. The one line that changes when the same images run against
# real S3 — everything else in the job code stays as it is.
S3_ENDPOINT=http://minio:9000

# Credentials, read by SimpleAWSCredentialsProvider from AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY. Must match what 05-minio was started with.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
