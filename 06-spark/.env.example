# ============================================================================
#  Copy to .env before starting:  cp .env.example .env
#
#  This stack includes 05-minio, which includes 04-etl, 03-dbms, 02-monitoring
#  and 01-kafka. Each reads its own .env from its own directory — all six must
#  exist. `make up` checks.
# ============================================================================

# ---- Spark -----------------------------------------------------------------
# Version 3.5, not 4.x, and the choice is deliberate.
#
# Spark's ability to read s3a:// rests on a chain: the Spark build bundles a
# specific Hadoop version, hadoop-aws must match it exactly, and the AWS SDK
# must match what that hadoop-aws was compiled against. The 3.5 line is the
# best-trodden combination — most working examples target it, and hadoop-aws
# for Hadoop 3.3.x has years of use behind it. Spark 4 also moved to the v2
# AWS SDK, which adds its own class of incompatibilities.
#
# Tags from hub.docker.com/r/apache/spark/tags. The `-r` variants add the R
# runtime and SparkR, which nothing here uses.
SPARK_VERSION=3.5.9
SPARK_IMAGE=apache/spark:3.5.9-scala2.12-java17-python3-ubuntu

# NOT free choices. Spark 3.5.9 compiles in Hadoop 3.3.4, so hadoop-aws is
# 3.3.4, and the SDK is what that was built against. A mismatch gives
# NoSuchMethodError or ClassNotFoundException from deep in the stack, naming
# neither S3 nor versions. The jars are baked into the image at build time so
# a wrong pair fails the build instead of a running job.
#
# `make jars` prints the Hadoop version this Spark build actually contains.
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_VERSION=1.12.262

# ---- Cluster shape ---------------------------------------------------------
# What each worker OFFERS to the cluster. Four workers rather than two so a
# job visibly spreads across executors instead of merely running.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=8g

# ---- What a job actually gets ----------------------------------------------
# These are separate from the worker settings, and the distinction matters.
#
# SPARK_WORKER_MEMORY is what a worker offers. spark.executor.memory is what
# one executor asks for, and it defaults to 1 GiB no matter how much the
# worker offered. Raising only the worker figure increases the cluster's
# capacity and not a single executor — a job still runs in 1 GiB and still
# spills to disk.
#
# Sized so exactly one executor fits per worker: 6 GiB of an 8 GiB offer, with
# the remainder left for JVM overhead outside the heap, which Spark does not
# count against this number.
SPARK_EXECUTOR_MEMORY=6g
SPARK_EXECUTOR_CORES=2

# The ceiling on cores one application may hold across the whole cluster.
# Without it a single job takes every core and the next one waits — which on a
# standalone cluster looks like a hung scheduler.
SPARK_CORES_MAX=8

# The driver runs inside the job container, not on a worker. It collects
# results and holds the plan; it needs far less than an executor unless
# something calls collect() on a large frame.
SPARK_DRIVER_MEMORY=2g

# ---- Ports -----------------------------------------------------------------
# 8080 on the host is Kafbat UI and 8081 is Airflow, so the Spark master UI
# goes to 8090.
SPARK_MASTER_UI_PORT=8090
SPARK_MASTER_PORT=7077

# ---- Object storage --------------------------------------------------------
# Where S3A points. The one line that changes when the same images run against
# real S3 — everything else in the job code stays as it is.
S3_ENDPOINT=http://minio:9000

# Credentials, read by SimpleAWSCredentialsProvider from AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY. Must match what 05-minio was started with.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- Job images ------------------------------------------------------------
# Tag for the locally built Spark job images.
JOB_VERSION=0.1.0

SCALA_BINARY=2.12

# The gid that owns /var/run/docker.sock.
#
# Repeated in every stack rather than inherited. Compose resolves variables
# from the .env beside the file being run, so the value 02-monitoring sets is
# invisible when the same services are started from here — the substitution
# falls back to 0, Prometheus cannot read the socket, and service discovery
# finds nothing while every static target keeps working.
#
# 0 on Docker Desktop, where the socket inside the VM is root:root; usually
# 999 on a Linux host, where it is root:docker. Find yours:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
