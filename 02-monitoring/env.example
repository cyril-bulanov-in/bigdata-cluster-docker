# ============================================================================
#  Copy to .env before starting:  cp .env.example .env
#
#  The name matters: Compose looks for a file called exactly `.env`, with the
#  leading dot. A file named `env` sits in the same directory and is ignored,
#  and every variable below silently becomes an empty string — which shows up
#  much later as "invalid reference format" on an image name.
#
#  .env is git-ignored; only this template lives in the repository.
#
#  01-kafka/.env must exist as well. This stack pulls the Kafka services in
#  through `include`, and the included file reads its own .env from 01-kafka/.
#  `make up` checks for both before starting anything.
# ============================================================================

# ---- Image versions --------------------------------------------------------
# Pinned on purpose. A floating tag eventually pulls a version whose metric
# names or flags changed, and the stack breaks with no change on your side.
PROMETHEUS_VERSION=v3.14.0
GRAFANA_VERSION=13.2.0
NODE_EXPORTER_VERSION=v1.12.1
KAFKA_EXPORTER_VERSION=v1.9.0

# Built locally rather than pulled. Both of these are downloaded from their
# projects' GitHub releases during the image build.
#   jmx_exporter: jar, verified against the published sha256
#   cAdvisor:     static binary; the project publishes no checksum, so the
#                 build runs the binary instead as a sanity check
JMX_EXPORTER_VERSION=1.6.0
CADVISOR_VERSION=v0.60.5

# ---- Ports on the host -----------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# 8080 is already taken by Kafbat UI from step 1
CADVISOR_PORT=8082

# ---- Prometheus ------------------------------------------------------------
# How long metrics are kept on local disk. Long-term storage is a different
# problem, solved with remote write rather than with a bigger number here.
PROMETHEUS_RETENTION=15d

# ---- Grafana ---------------------------------------------------------------
# Applied on first start only, then stored in Grafana's own database. Changing
# them here later has no effect: the account already exists. To change the
# password afterwards use the UI, or `make clean` and start over.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
