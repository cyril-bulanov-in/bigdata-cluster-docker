    {
      "type": "timeseries",
      "title": "CPU used",
      "description": "On Docker Desktop this is the Linux VM, not your laptop.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
