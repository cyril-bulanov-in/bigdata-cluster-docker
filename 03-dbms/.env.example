# ============================================================================
#  Copy to .env before starting:  cp .env.example .env
#
#  The name matters: Compose looks for a file called exactly `.env`, with the
#  leading dot. A file named `env` sits in the same directory and is ignored.
#
#  This stack includes 02-monitoring, which includes 01-kafka, and each of
#  those reads its own .env from its own directory. All three must exist;
#  `make up` checks.
# ============================================================================

# ---- Image versions --------------------------------------------------------
POSTGRES_VERSION=17
POSTGRES_EXPORTER_VERSION=v0.20.1

# ClickHouse. The same tag serves the servers and Keeper: they are built from
# one source tree and are meant to match.
#
# 26.8 is the current long-term-support line. LTS rather than the newest
# stable on purpose — ClickHouse ships a release every month, and a warehouse
# is not where monthly surprises belong.
#
# Pin from the REGISTRY, not from the source releases on GitHub; that is the
# lesson from Debezium. If this tag does not resolve, the real list is at
# hub.docker.com/r/clickhouse/clickhouse-server/tags, and the two-part `26.8`
# works as a fallback.
CLICKHOUSE_VERSION=26.8.2.7

# Debezium's own Connect image, which already contains every Debezium
# connector. Tags at quay.io/repository/debezium/connect.
DEBEZIUM_VERSION=3.6.1.Final

# The JMX exporter image is BUILT BY 02-monitoring, not here. This must match
# JMX_EXPORTER_VERSION in ../02-monitoring/.env; `make up` checks and refuses
# to start if the two differ.
JMX_EXPORTER_VERSION=1.6.0

# Tag for the locally built generator image.
GENERATOR_VERSION=0.1.0

# ---- Ports on the host -----------------------------------------------------
POSTGRES_PORT=5432
CONNECT_PORT=8083

# ClickHouse HTTP, one per node. All eight are published so each replica can
# be asked separately what it sees — which is the whole point during a
# replication drill.
CH_HTTP_PORT_01=8123
CH_HTTP_PORT_02=8124
CH_HTTP_PORT_03=8125
CH_HTTP_PORT_04=8126
CH_HTTP_PORT_05=8127
CH_HTTP_PORT_06=8128
CH_HTTP_PORT_07=8129
CH_HTTP_PORT_08=8130

# The native protocol, first node only. Deliberately not 9000: MinIO arrives
# in step 07 and takes that port on the host. Inside the docker network every
# node still listens on 9000, which is what the cluster configuration refers to.
CH_NATIVE_PORT_01=9010

# postgres-exporter, jmx-connect and the Keepers publish no host ports: only
# Prometheus reads them, over the docker network.

# ---- Database (Postgres) ---------------------------------------------------
# Applied only when the postgres-data volume is created. Changing them later
# has no effect on an existing volume — the same trap as the Grafana password.
POSTGRES_DB=shop
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# ---- ClickHouse ------------------------------------------------------------
CH_DB=analytics

# Memory ceiling per ClickHouse container. ClickHouse reads its cgroup limit,
# and config.d/30-limits.xml lets it use 70% of that.
#
# EIGHT nodes now, so this is 16 GiB of the Docker budget before Kafka,
# Prometheus and the rest. With Docker Desktop set to 48 GiB there is room;
# on a smaller allocation, drop this to 1g before starting.
CLICKHOUSE_MEM_LIMIT=2g

# The `default` user has no password — see clickhouse/server/users.d for why,
# and for what would have to change before this is exposed anywhere.

# ---- Kafka Connect ---------------------------------------------------------
CONNECT_HEAP_OPTS=-Xms256m -Xmx1g

# ---- Seeding ---------------------------------------------------------------
SEED_CUSTOMERS=2000
SEED_PRODUCTS=200

# ---- Load shape ------------------------------------------------------------
# The generator runs one cycle per order. Raising the rate raises every kind
# of change proportionally, because the rest are probabilities per cycle.
ORDERS_PER_MINUTE=30
P_ADVANCE_ORDER=0.60
P_UPDATE_PRICE=0.05
P_NEW_CUSTOMER=0.03
P_DELETE_CUSTOMER=0.01
