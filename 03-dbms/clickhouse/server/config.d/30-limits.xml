<?xml version="1.0"?>
<!--
  ============================================================================
   Resource limits for a laptop
  ============================================================================
   ClickHouse is built to own the machine it runs on. Four of them on a
   developer machine, alongside Kafka and everything else, is not that
   situation, so a couple of defaults have to be brought down.

   Note what is NOT here: background_pool_size.

   Lowering it looks harmless and is not. ClickHouse validates on startup that

       background_pool_size * background_merges_mutations_concurrency_ratio
           > number_of_free_entries_in_pool_to_execute_mutation

   and refuses to start otherwise:

       Code: 36. DB::Exception: The value of
       'number_of_free_entries_in_pool_to_execute_mutation' setting (20) is
       greater than the value of 'background_pool_size' *
       'background_merges_mutations_concurrency_ratio' (16). This indicates
       incorrect configuration because mutations cannot work with these
       settings. (BAD_ARGUMENTS)

   Setting the pool to 8 gives 8 * 2 = 16, and the mutation threshold defaults
   to 20. Lowering the pool therefore means lowering the merge_tree thresholds
   with it — several interdependent knobs, for a saving that does not exist:
   these pools grow lazily, so an idle node never creates the threads anyway.

   The memory settings below are the ones that actually matter, and they have
   no such couplings.
  ============================================================================
-->
<clickhouse>

    <!-- Fraction of available memory a server may use. ClickHouse reads the
         container's cgroup limit, so this is a fraction of the container
         limit rather than of the whole machine. 0.7 leaves room for the page
         cache, which ClickHouse relies on as much as Kafka does. -->
    <max_server_memory_usage_to_ram_ratio>0.7</max_server_memory_usage_to_ram_ratio>

    <!-- Caches. The defaults are sized for a server with hundreds of
         gigabytes; multiplied by four nodes they would be most of the budget
         before a single query ran. -->
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>134217728</uncompressed_cache_size>

    <logger>
        <level>information</level>
        <console>true</console>
    </logger>

</clickhouse>
