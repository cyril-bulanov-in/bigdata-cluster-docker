# ============================================================================
#  profiles/light.env — what continuous integration runs
# ============================================================================
#  Sourced by `make up-light`.
#
#  Identical to 16.env in every respect but one: the warehouse is two nodes
#  rather than four, as two shards of ONE replica.
#
# ----------------------------------------------------------------------------
#  The one thing CI cannot cover, and why
# ----------------------------------------------------------------------------
#  A GitHub runner has 16 GiB with roughly 14 usable once the OS and the
#  Docker daemon have taken theirs. The four-node warehouse in 16.env brings
#  the platform to about 13.8 GiB — which fits, with nothing to spare.
#
#  An out-of-memory kill at 98% of capacity is intermittent, and intermittent
#  CI is worse than CI that skips something openly. So the fourth and third
#  ClickHouse nodes go, and with them replication.
#
#  What survives: sharding, Distributed tables, the sharding-key lesson, and
#  the GLOBAL JOIN trap from step 4 — all of which need two shards and not two
#  replicas.
#
#  What does not: ReplicatedReplacingMergeTree actually replicating, and the
#  replica-failure drill in 03-dbms/README.md. Run `make up-16` locally to
#  cover those.
#
#  Measured total: roughly 11.6 GiB, leaving about 2.4 GiB of headroom.
# ============================================================================

# ---- the warehouse ---------------------------------------------------------
# Two shards, one replica each, one Keeper. Keeper is still required even with
# a single replica — the table engine is Replicated regardless.
CLICKHOUSE_PROFILE=clickhouse-2

CLICKHOUSE_MEM_LIMIT=1250m
CLICKHOUSE_MEMORY_RATIO=0.9
CLICKHOUSE_MAX_BYTES_BEFORE_EXTERNAL_GROUP_BY=400000000
CLICKHOUSE_MAX_MEMORY_USAGE=900000000

# ----------------------------------------------------------------------------
#  Values with spaces are quoted, and must be
# ----------------------------------------------------------------------------
#  These files are SOURCED by the shell, not parsed by Compose. An unquoted
#
#      KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
#
#  makes the shell read the space as a separator and try to run -Xmx512m as a
#  command. It prints "not found", carries on, and leaves the variable holding
#  only the first half — so the JVM gets a minimum heap and no maximum, and
#  nothing says so.
#
#  A .env file read by Compose would not need the quotes. These are not that.
# ----------------------------------------------------------------------------

# ---- Kafka -----------------------------------------------------------------
KAFKA_HEAP_OPTS="-Xms256m -Xmx512m"
KAFKA_MEM_LIMIT=1g
CONNECT_HEAP_OPTS="-Xms256m -Xmx768m"
CONNECT_MEM_LIMIT=1200m

# ---- monitoring ------------------------------------------------------------
PROMETHEUS_MEM_LIMIT=768m
GRAFANA_MEM_LIMIT=384m
CADVISOR_MEM_LIMIT=256m

# ---- orchestration ---------------------------------------------------------
AIRFLOW_MEM_LIMIT=768m

# ---- Spark -----------------------------------------------------------------
SPARK_WORKER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=768m
SPARK_DRIVER_MEMORY=768m
SPARK_CORES_MAX=4

# ---- storage and dashboards ------------------------------------------------
MINIO_MEM_LIMIT=512m
SUPERSET_MEM_LIMIT=1g

# ---- the Docker socket -----------------------------------------------------
# Overwritten by every workflow with the runner's actual gid. Present here so
# the variable exists rather than falling back to a default that grants
# nothing — the failure that left service discovery blind for five steps.
DOCKER_GID=0
