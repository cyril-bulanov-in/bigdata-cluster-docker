# ============================================================================
#  Environment variables. Copy this file to .env — docker compose picks it up
#  automatically:
#      cp .env.example .env
#  .env itself is git-ignored, so only this template lives in the repository.
# ============================================================================

# ---- Image versions --------------------------------------------------------
# Always pin exact versions. A `latest` tag will eventually pull an
# incompatible image and break the cluster without a single change on your side.
KAFKA_VERSION=4.3.1
KAFBAT_VERSION=v1.5.0

# ---- Cluster identifier ----------------------------------------------------
# A single UUID shared by all four nodes. Generate your own with:
#   docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
# It cannot be changed on a running cluster — nodes reject a foreign id.
# If you do change it, run `make clean` to wipe the volumes first.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# ---- Resources -------------------------------------------------------------
# JVM heap per broker. Kafka leans heavily on the OS page cache, so a large
# heap buys little — leaving memory to the system matters far more.
KAFKA_HEAP_OPTS=-Xms512m -Xmx1g

# Hard memory ceiling per container. Set above the heap on purpose: the JVM
# also allocates outside it (metaspace, network buffers, mmapped indexes).
KAFKA_MEM_LIMIT=2g

# ---- Host ports ------------------------------------------------------------
# Kafbat UI
KAFBAT_PORT=8080

# Broker ports for connecting from the host are set in the compose file:
#   kafka-1 -> localhost:29091
#   kafka-2 -> localhost:29092
#   kafka-3 -> localhost:29093
#   kafka-4 -> localhost:29094
