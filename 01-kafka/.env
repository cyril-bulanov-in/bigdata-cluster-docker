# ============================================================================
#  Переменные окружения. Скопируй в .env — docker compose подхватит его сам.
#      cp .env.example .env
#  Файл .env в git не попадает (см. .gitignore) — здесь лежат только примеры.
# ============================================================================

# ---- Версии образов --------------------------------------------------------
# Всегда пиним конкретные версии. Тег latest однажды подтянет несовместимый
# образ, и стенд сломается без единого изменения в коде.
KAFKA_VERSION=4.3.1
KAFBAT_VERSION=v1.5.0

# ---- Идентификатор кластера ------------------------------------------------
# Общий UUID для всех четырёх узлов. Сгенерировать свой:
#   docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
# Менять после первого запуска нельзя: узлы не примут чужой id.
# Если всё же поменял — нужен `make clean` (снос томов).
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# ---- Ресурсы ---------------------------------------------------------------
# Heap для JVM каждого брокера. Kafka активно использует page cache ОС,
# поэтому большой heap ей не нужен — гораздо важнее оставить память системе.
KAFKA_HEAP_OPTS=-Xms512m -Xmx1g

# Жёсткий потолок памяти на контейнер. Берём с запасом над heap:
# JVM ест ещё и вне кучи (metaspace, буферы сети, mmap индексов).
KAFKA_MEM_LIMIT=2g

# ---- Порты на хосте --------------------------------------------------------
# Веб-интерфейс Kafbat UI
KAFBAT_PORT=8080

# Порты брокеров для подключения с мака заданы в compose-файле:
#   kafka-1 → localhost:29091
#   kafka-2 → localhost:29092
#   kafka-3 → localhost:29093
#   kafka-4 → localhost:29094
