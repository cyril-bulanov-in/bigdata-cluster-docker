# ============================================================================
#  Copy to .env before starting:  cp .env.example .env
#
#  This stack includes 04-etl, which includes 03-dbms, 02-monitoring and
#  01-kafka. Each reads its own .env from its own directory — all five must
#  exist. `make up` checks.
# ============================================================================

# ---- Image versions --------------------------------------------------------
# MinIO tags are release timestamps, not semantic versions. Take the newest
# from github.com/minio/minio/releases — there is no "latest stable" line to
# follow, so this is pinned to a specific day.
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z

# The command-line client, used in part 2 to create buckets and policies.
MC_VERSION=RELEASE.2025-08-13T08-35-41Z

# ---- Ports -----------------------------------------------------------------
# 9000 is the S3 API. Free because ClickHouse's native port was put on 9010 in
# step 3 specifically to leave it available.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Credentials -----------------------------------------------------------
# These become the S3 access key and secret key. Jobs receive them through the
# environment, so pointing a job at real S3 later means changing these two
# values and the endpoint, and nothing else.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- Bucket layout ---------------------------------------------------------
# Three layers, three buckets. Separate buckets rather than prefixes in one,
# because lifecycle rules and access policies are set per bucket — a retention
# rule on raw then cannot reach curated by accident.
#
#   raw      exactly what arrived, never edited
#   staged   parsed, typed, deduplicated
#   curated  modelled for the queries that actually run
BUCKET_RAW=raw
BUCKET_STAGED=staged
BUCKET_CURATED=curated

# How long the raw layer is kept. This is a retention decision, not a cost
# one: it says how far back a transformation can be re-run from source.
RAW_RETENTION_DAYS=30
