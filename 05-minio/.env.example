# ============================================================================
#  Copy to .env before starting:  cp .env.example .env
#
#  This stack includes 04-etl, which includes 03-dbms, 02-monitoring and
#  01-kafka. Each reads its own .env from its own directory — all five must
#  exist. `make up` checks.
# ============================================================================

# ---- Image versions --------------------------------------------------------
# From quay.io, not Docker Hub, and that is not a preference.
#
# MinIO publishes to quay.io now. The Docker Hub copies stopped being updated,
# and some tags that exist on quay are simply absent there — a pull then fails
# with
#     pull access denied for minio/mc, repository does not exist
#     or may require 'docker login'
# which reads like a rate limit or a typo and is neither. It also only shows
# up on a clean machine: locally the image is already there from an earlier
# pull, so the stack keeps working while CI cannot start it.
#
# Tags are release timestamps, not semantic versions. Confirm one exists
# before committing it:
#   docker manifest inspect quay.io/minio/minio:<tag> >/dev/null && echo ok
MINIO_IMAGE=quay.io/minio/minio
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z

# The command-line client, used by minio-init to create buckets and policies.
MC_IMAGE=quay.io/minio/mc
MC_VERSION=RELEASE.2025-08-13T08-35-41Z

# ---- Ports -----------------------------------------------------------------
# 9000 is the S3 API. Free because ClickHouse's native port was put on 9010 in
# step 3 specifically to leave it available.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Credentials -----------------------------------------------------------
# These become the S3 access key and secret key. Jobs receive them through the
# environment, so pointing a job at real S3 later means changing these two
# values and the endpoint, and nothing else.
#
# Read only when the minio-data volume is created. Editing them afterwards
# changes nothing — the same trap as the Grafana password and POSTGRES_PASSWORD.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- Bucket layout ---------------------------------------------------------
# Three layers, three buckets. Separate buckets rather than prefixes in one,
# because lifecycle rules and access policies are set per bucket — a retention
# rule on raw then cannot reach curated by accident.
#
#   raw      exactly what arrived, never edited
#   staged   parsed, typed, deduplicated
#   curated  modelled for the queries that actually run
BUCKET_RAW=raw
BUCKET_STAGED=staged
BUCKET_CURATED=curated

# How long the raw layer is kept. A retention decision, not a cost one: it
# says how far back a transformation can be re-run from source.
RAW_RETENTION_DAYS=30
