# ============================================================================
#  Copy to .env before starting:  cp .env.example .env
#
#  This stack includes 03-dbms, which includes 02-monitoring, which includes
#  01-kafka. Each of those reads its own .env from its own directory — all
#  four must exist. `make up` checks.
# ============================================================================

# ---- Image versions --------------------------------------------------------
AIRFLOW_VERSION=3.3.1
STATSD_EXPORTER_VERSION=v0.28.0

# Used for Airflow's own metadata database. Same version as the source
# database in 03-dbms, but a completely separate instance.
POSTGRES_VERSION=17

# ---- Ports -----------------------------------------------------------------
# 8080 is Kafbat UI, 8081 is free.
AIRFLOW_PORT=8081

# ---- Airflow metadata database ---------------------------------------------
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow

# ---- Airflow ---------------------------------------------------------------
# There is no login. AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_ALL_ADMINS is on, so
# the UI opens straight to the DAG list and every request counts as an admin.
# See the comment in docker-compose.yml for why, and for what to change before
# this is reachable from anywhere but this machine.

# Encrypts connection passwords and variables stored in the metadata
# database. Pinned rather than generated, because a new key on restart makes
# every previously stored secret undecryptable.
#
# Generate your own for anything real:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=Zt7Ck9Xq2Lm4Pv8Rw1Ny6Hb3Jd5Fg0Ts9Uc2Ae4Ik=

# Signs session cookies and API tokens. Same reasoning.
AIRFLOW_SECRET_KEY=change-me-for-anything-that-is-not-a-laptop
AIRFLOW_JWT_SECRET=local-stand-jwt-secret-change-me

# ---- Job images ------------------------------------------------------------
# Tag for the locally built job images. Bump it when a job changes so a DAG
# pinned to the old tag keeps running the code it was tested against.
JOB_VERSION=0.1.0
