# ============================================================================
#  Copy to .env before starting:  cp .env.example .env
#
#  This stack includes 06-spark, which includes 05-minio, 04-etl, 03-dbms,
#  02-monitoring and 01-kafka. Each reads its own .env from its own directory
#  — all seven must exist. `make up` checks.
# ============================================================================

# ---- The dbt image ---------------------------------------------------------
# Tag for the locally built image. Bump it when the models change so a DAG
# pinned to the old tag keeps running the SQL it was tested against.
DBT_VERSION=0.1.0

# ---- The documentation site ------------------------------------------------
# `dbt docs generate` writes static files; nginx serves them. 8088 because
# 8080 is Kafbat UI, 8081 Airflow, 8082 cAdvisor and 8090 the Spark master.
NGINX_VERSION=1.29-alpine
DBT_DOCS_PORT=8088

# ---- Where dbt connects ----------------------------------------------------
# The native protocol on 9000, not HTTP on 8123: dbt issues many small
# statements during a run and the lower per-query overhead shows.
#
# clickhouse-01 is the coordinator the rest of the platform already uses.
# Every node would work — the cluster has no special one — but sending all of
# dbt's DDL through a single node keeps the sequence legible in the query log.
CLICKHOUSE_HOST=clickhouse-01
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Where dbt writes. Its own database rather than `analytics`, which holds the
# CDC staging tables: a model named like a source table would otherwise be
# able to overwrite it, and `dbt run` is not a command that should be capable
# of that.
#
# The layers land in <DBT_SCHEMA>_staging and <DBT_SCHEMA>_marts, because
# dbt appends the per-directory schema from dbt_project.yml to this.
DBT_SCHEMA=marts

# Which output block in profiles.yml to use. One target for now; a second
# would appear when there is somewhere else to point at.
DBT_TARGET=dev

# ---- Where the sources are -------------------------------------------------
# The CDC staging layer built in 03-dbms.
SOURCE_DATABASE=analytics

# Postgres, read directly rather than through change capture. Not a duplicate
# of the CDC path: it is for the things capture does not carry — reference
# tables outside the publication, and reconciling the warehouse against the
# source it claims to mirror.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shop
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Object storage, for the Parquet Spark writes. Read through ClickHouse's own
# s3 table function, so dbt stays a single-database project while seeing all
# three sources in one query.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_STAGED=staged
