# ============================================================================
#  Copy to .env before starting:  cp .env.example .env
#
#  This stack includes 07-dbt, which includes 06-spark, 05-minio, 04-etl,
#  03-dbms, 02-monitoring and 01-kafka. Each reads its own .env from its own
#  directory — all eight must exist. `make up` checks.
# ============================================================================

# ---- Superset --------------------------------------------------------------
# Confirm a tag exists before committing it. The registry is the authority,
# not the project's release notes:
#   docker manifest inspect apache/superset:<tag> >/dev/null && echo ok
SUPERSET_VERSION=6.1.0

# 8089 rather than Superset's own 8088, which the dbt documentation site in
# step 7 already occupies. Inside the container it still listens on 8088.
SUPERSET_PORT=8089

# ---- The secret key --------------------------------------------------------
# Encrypts the passwords of every database connection Superset stores, and
# signs session cookies.
#
# Changing it after connections exist makes them unreadable: Superset starts,
# the connections are listed, and every query through them fails to decrypt.
# Pinned here for the same reason as Airflow's Fernet key.
#
# Generate your own for anything that is not a local stand:
#   openssl rand -base64 42
SUPERSET_SECRET_KEY=CHANGE-ME-local-stand-only-aG9tZS1sYWItb25seS1ub3Qtc2VjcmV0

# ---- The admin account -----------------------------------------------------
# Created once, by superset-init, on the first start with an empty metadata
# volume. Editing these afterwards changes nothing — the account then lives in
# Superset's own database. To change the password later:
#   docker compose exec superset superset fab reset-password --username admin
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com

# ---- Metadata database -----------------------------------------------------
# Superset's own Postgres, not the operational one being captured and not
# Airflow's.
#
# POSTGRES_VERSION is repeated here rather than inherited. An included compose
# file resolves variables from the .env beside ITSELF, so the value 03-dbms
# sets is invisible to this file — the substitution would come out empty and
# the image would be `postgres:`, which fails with a message about an invalid
# reference format rather than about a missing variable.
POSTGRES_VERSION=17

SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=superset

# ---- Redis -----------------------------------------------------------------
# Caching only, no Celery worker. Four logical databases on one instance:
# chart data, query results, dashboard filter state, explore form state.
REDIS_VERSION=8.2-alpine

# ---- Where the data is -----------------------------------------------------
# The dbt marts from step 7. Used from the next part onward, when the
# connection is provisioned.
CLICKHOUSE_HOST=clickhouse-01
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_MARTS_DB=marts_marts

# The gid that owns /var/run/docker.sock.
#
# Repeated in every stack rather than inherited. Compose resolves variables
# from the .env beside the file being run, so the value 02-monitoring sets is
# invisible when the same services are started from here — the substitution
# falls back to 0, Prometheus cannot read the socket, and service discovery
# finds nothing while every static target keeps working.
#
# 0 on Docker Desktop, where the socket inside the VM is root:root; usually
# 999 on a Linux host, where it is root:docker. Find yours:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
